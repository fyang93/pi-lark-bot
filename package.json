{
  "name": "pi-lark-bot",
  "version": "0.1.0",
  "description": "Opt-in Feishu/Lark bot with independent per-user and per-group pi sessions in tmux",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "lark",
    "feishu",
    "tmux"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test --test-timeout=30000 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "node test/run-integration.mjs",
    "test:integration:worker": "tsx --test --test-timeout=100000 test/integration.test.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
