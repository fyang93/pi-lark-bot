{
  "name": "pi-lark-bot",
  "version": "0.4.0",
  "description": "Opt-in Feishu/Lark bot with independent per-user and per-group pi sessions in herdr",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "lark",
    "feishu",
    "herdr"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test --test-concurrency=1 --test-timeout=30000 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.0",
    "typebox": "^1.3.34",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
